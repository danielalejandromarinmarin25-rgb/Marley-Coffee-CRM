# Variables de la Edge Function invite-user en local (supabase start la carga desde functions/.env).
# SUPABASE_URL y las claves las inyecta Supabase; no se escriben aquí.
APP_URL=http://127.0.0.1:5174

# enviar-resumen (correo con Resend). Sin RESEND_API_KEY corre en modo prueba (no envía nada).
# La API key de Resend es SECRETA: solo aquí (archivo ignorado por git) o como secreto de la función.
RESEND_API_KEY=
# Remitente. Sin dominio verificado en Resend, solo sirve onboarding@resend.dev.
RESEND_FROM=Marley Conecta <onboarding@resend.dev>
# Sin dominio verificado, Resend solo entrega al correo dueño de la cuenta: todos los resúmenes van ahí.
RESEND_SOLO_A=
RESEND_LIMITE_DIARIO=90
