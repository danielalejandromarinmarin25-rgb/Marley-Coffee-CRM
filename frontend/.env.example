# Marley Conecta · frontend
# Copia este archivo a .env.local (git lo ignora) y completa los valores.
# Solo van valores PÚBLICOS: todo lo que empieza con VITE_ queda dentro del JavaScript que
# descarga el navegador. Nunca pongas aquí la clave secreta (service_role / sb_secret_…)
# ni la API key de Resend.

# URL del proyecto: Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Clave publicable (sb_publishable_…) o anon heredada: Supabase → Project Settings → API Keys
VITE_SUPABASE_ANON_KEY=
